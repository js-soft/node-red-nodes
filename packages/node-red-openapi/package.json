{
  "name": "@js-soft/node-red-openapi",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "A modified version of openapi-red (OpenAPI/Swagger client for Node-RED) with improved error handling, maintained by js-soft",
  "author": "Sebastian Meier",
  "contributors": [
    "Sebastian Meier",
    "Christian Geiger",
    "Jakob Erben <jakob.erben@js-soft.com>"
  ],
  "main": "src/openApi-red.js",
  "scripts": {
    "setup": "npm install && mkdir -p /home/node/.node-red/ && cd /home/node/.node-red/ && npm link /workspaces/openapi-red --save && cd /workspaces/openapi-red",
    "dev": "node-red examples/petstore.json",
    "build": "sir",
    "build:watch": "nodemon --watch src --ext svelte --exec 'npm run build'",
    "test": "node --test"
  },
  "keywords": [
    "node-red",
    "swagger",
    "swagger client",
    "openAPI",
    "openAPI client",
    "open api",
    "open api client",
    "open",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/js-soft/node-red-nodes.git",
    "directory": "packages/node-red-openapi"
  },
  "files": [
    "src",
    "icons",
    "editor.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "openApi-red": "src/openapi.js",
      "openApi-red-url": "src/config.js"
    }
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "swagger-client": "^3.36.0",
    "tinypool": "^2.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "standard": "17.1.2",
    "svelte-integration-red": "2.13.4"
  },
  "engines": {
    "node": "24.x"
  }
}
